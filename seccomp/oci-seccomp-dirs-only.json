{
  "defaultAction": "SCMP_ACT_ALLOW",
  "architectures": ["SCMP_ARCH_X86_64", "SCMP_ARCH_X86", "SCMP_ARCH_AARCH64"],
  "syscalls": [
    {
      "names": ["rmdir"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    },
    {
      "names": ["unlinkat"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1,
      "args": [
        { "index": 2, "value": 512, "valueTwo": 512, "op": "SCMP_CMP_MASKED_EQ" }
      ],
      "comment": "deny unlinkat when AT_REMOVEDIR (0x200) is set; same as sandbox-run --mode workdir-safe"
    }
  ]
}
