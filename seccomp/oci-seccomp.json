{
  "defaultAction": "SCMP_ACT_ALLOW",
  "architectures": ["SCMP_ARCH_X86_64", "SCMP_ARCH_X86", "SCMP_ARCH_AARCH64"],
  "syscalls": [
    {
      "names": ["unlink", "rmdir", "rename", "renameat", "renameat2"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1,
      "comment": "strict mode: no deletion / rename-over. EPERM = 1."
    },
    {
      "names": ["unlinkat"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1,
      "comment": "unlinkat unconditionally in strict mode. For 'directories only' use the args variant below instead."
    },
    {
      "names": ["fork", "vfork"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1,
      "comment": "no new processes"
    },
    {
      "names": ["clone"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1,
      "args": [
        { "index": 0, "value": 65536, "valueTwo": 0, "op": "SCMP_CMP_MASKED_EQ" }
      ],
      "comment": "deny clone() when CLONE_THREAD (0x10000) is NOT set, i.e. new processes; threads still allowed"
    },
    {
      "names": ["clone3"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 38,
      "comment": "ENOSYS so libc falls back to clone(); clone3 flags are in a struct and cannot be inspected"
    },
    {
      "names": [
        "ptrace", "process_vm_readv", "process_vm_writev",
        "mount", "umount2", "pivot_root", "unshare", "setns",
        "personality", "userfaultfd", "open_by_handle_at",
        "kexec_load", "kexec_file_load",
        "init_module", "finit_module", "delete_module",
        "bpf", "perf_event_open",
        "memfd_create", "pidfd_getfd",
        "io_uring_setup", "io_uring_enter", "io_uring_register",
        "open_tree", "move_mount", "fsopen", "fsconfig", "fsmount", "fspick",
        "add_key", "request_key", "keyctl"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1,
      "comment": "both modes: block escape and privilege syscalls. EPERM = 1."
    }
  ]
}
